#!/usr/bin/env python3
"""Dependency-free, safety-biased Calendly API CLI."""

from __future__ import annotations

import argparse
import json
import os
import random
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode, urljoin, urlparse
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parent
DEFAULT_BASE_URL = "https://api.calendly.com"
READ_METHODS = {"GET", "HEAD"}
WRITE_METHODS = {"POST", "PUT", "PATCH"}
DESTRUCTIVE_METHODS = {"DELETE"}


class CliError(RuntimeError):
    pass


def load_env(path: Path) -> None:
    if not path.exists():
        return
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key and key not in os.environ:
            os.environ[key] = value.strip().strip('"').strip("'")


def api_base() -> str:
    base = os.environ.get("CALENDLY_API_BASE", DEFAULT_BASE_URL).rstrip("/")
    parsed = urlparse(base)
    if parsed.scheme != "https" or not parsed.netloc or parsed.path or parsed.params or parsed.query or parsed.fragment:
        raise CliError("CALENDLY_API_BASE must be an HTTPS origin with no path")
    if base != DEFAULT_BASE_URL and os.environ.get("CALENDLY_ALLOW_CUSTOM_API_BASE") != "1":
        raise CliError("custom API bases require CALENDLY_ALLOW_CUSTOM_API_BASE=1 to protect the token")
    return base


def token() -> str:
    value = os.environ.get("CALENDLY_TOKEN", "").strip()
    if not value:
        raise CliError("CALENDLY_TOKEN is missing; copy .env.example to .env")
    return value


def safe_path(path: str) -> str:
    parsed = urlparse(path)
    if parsed.scheme or parsed.netloc or not path.startswith("/"):
        raise CliError("API path must start with / and cannot be an absolute URL")
    if any(part == ".." for part in parsed.path.split("/")):
        raise CliError("API path cannot contain ..")
    return path


def decode_response(raw: bytes, content_type: str) -> Any:
    if not raw:
        return None
    text = raw.decode("utf-8", errors="replace")
    if "json" in content_type.lower():
        return json.loads(text)
    return text


def request(method: str, path: str, body: Any = None, query: dict[str, str] | None = None) -> Any:
    method = method.upper()
    path = safe_path(path)
    if method not in READ_METHODS | WRITE_METHODS | DESTRUCTIVE_METHODS:
        raise CliError(f"unsupported HTTP method: {method}")
    url = urljoin(api_base() + "/", path.lstrip("/"))
    if query:
        url += ("&" if "?" in url else "?") + urlencode(query)
    payload = None if body is None else json.dumps(body).encode("utf-8")
    headers = {
        "Authorization": f"Bearer {token()}",
        "Accept": "application/json",
        "User-Agent": "calendly-config/1.0",
    }
    if payload is not None:
        headers["Content-Type"] = "application/json"

    attempts = 3 if method in READ_METHODS else 1
    for attempt in range(attempts):
        try:
            req = Request(url, data=payload, headers=headers, method=method)
            with urlopen(req, timeout=30) as response:
                return decode_response(response.read(), response.headers.get("Content-Type", ""))
        except HTTPError as exc:
            raw = exc.read()
            detail = decode_response(raw, exc.headers.get("Content-Type", ""))
            retryable = exc.code == 429 or 500 <= exc.code < 600
            if method in READ_METHODS and retryable and attempt + 1 < attempts:
                retry_after = exc.headers.get("Retry-After", "")
                delay = float(retry_after) if retry_after.isdigit() else (2**attempt + random.random())
                time.sleep(min(delay, 10))
                continue
            raise CliError(f"Calendly returned HTTP {exc.code}: {json.dumps(detail, ensure_ascii=False)}") from None
        except URLError as exc:
            if method in READ_METHODS and attempt + 1 < attempts:
                time.sleep(2**attempt + random.random())
                continue
            raise CliError(f"Calendly request failed: {exc.reason}") from None
    raise CliError("Calendly request failed after retries")


def resource(payload: Any) -> Any:
    return payload.get("resource", payload) if isinstance(payload, dict) else payload


def current_user() -> dict[str, Any]:
    result = resource(request("GET", "/users/me"))
    if not isinstance(result, dict) or "uri" not in result:
        raise CliError("unexpected /users/me response")
    return result


def print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False))


def parse_query(items: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    for item in items:
        if "=" not in item:
            raise CliError(f"query must be key=value: {item}")
        key, value = item.split("=", 1)
        if not key:
            raise CliError("query key cannot be empty")
        result[key] = value
    return result


def links() -> None:
    user = current_user()
    payload = request("GET", "/event_types", query={"user": user["uri"]})
    collection = payload.get("collection", []) if isinstance(payload, dict) else []
    result = [
        {
            "active": item.get("active"),
            "duration_minutes": item.get("duration"),
            "name": item.get("name"),
            "scheduling_url": item.get("scheduling_url") or item.get("scheduling_uri"),
            "uri": item.get("uri"),
        }
        for item in collection
    ]
    print_json(result)


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise CliError(f"file not found: {path}") from None
    except json.JSONDecodeError as exc:
        raise CliError(f"invalid JSON in {path}: line {exc.lineno}, column {exc.colno}: {exc.msg}") from None


def validate_plan(plan: Any) -> list[dict[str, Any]]:
    if not isinstance(plan, dict) or not isinstance(plan.get("operations"), list) or not plan["operations"]:
        raise CliError("plan must contain a non-empty operations array")
    operations: list[dict[str, Any]] = []
    for index, operation in enumerate(plan["operations"], start=1):
        if not isinstance(operation, dict):
            raise CliError(f"operation {index} must be an object")
        method = str(operation.get("method", "")).upper()
        path = operation.get("path")
        if method not in WRITE_METHODS | DESTRUCTIVE_METHODS:
            raise CliError(f"operation {index} must use POST, PUT, PATCH, or DELETE")
        if not isinstance(path, str):
            raise CliError(f"operation {index} needs a path")
        safe_path(path)
        if method in DESTRUCTIVE_METHODS and operation.get("allow_destructive") is not True:
            raise CliError(f"operation {index} is destructive; set allow_destructive to true explicitly")
        if method in WRITE_METHODS and not isinstance(operation.get("body"), dict):
            raise CliError(f"operation {index} needs an object body")
        operations.append(operation)
    return operations


def redact(value: Any) -> Any:
    secret_keys = {"authorization", "token", "access_token", "refresh_token", "client_secret"}
    if isinstance(value, dict):
        return {key: ("[REDACTED]" if key.lower() in secret_keys else redact(item)) for key, item in value.items()}
    if isinstance(value, list):
        return [redact(item) for item in value]
    return value


def apply_plan(path: Path, execute: bool) -> None:
    operations = validate_plan(load_json(path))
    preview = [
        {
            "body": operation.get("body"),
            "method": operation["method"].upper(),
            "name": operation.get("name", f"operation {index}"),
            "path": operation["path"],
        }
        for index, operation in enumerate(operations, start=1)
    ]
    if not execute:
        print_json({"execute": False, "operations": preview})
        print("Preview only. Re-run with --yes to execute.", file=sys.stderr)
        return

    report: dict[str, Any] = {
        "finished_at": None,
        "plan": str(path),
        "results": [],
        "started_at": datetime.now(timezone.utc).isoformat(),
    }
    run_dir = ROOT / "history" / "runs"
    run_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    report_path = run_dir / f"{stamp}.json"
    try:
        for item, operation in zip(preview, operations):
            response = request(item["method"], item["path"], operation.get("body"))
            report["results"].append({**item, "response": redact(response), "status": "succeeded"})
            print(f"succeeded: {item['name']}", file=sys.stderr)
    except Exception as exc:
        report["results"].append({"error": str(exc), "status": "failed"})
        raise
    finally:
        report["finished_at"] = datetime.now(timezone.utc).isoformat()
        report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        print(f"run report: {report_path}", file=sys.stderr)
    print_json(report["results"])


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="verify token and show the authenticated account")
    sub.add_parser("links", help="list meeting types and public scheduling links")

    get = sub.add_parser("get", help="make a read-only Calendly API request")
    get.add_argument("path", help="API path beginning with /")
    get.add_argument("--query", action="append", default=[], metavar="KEY=VALUE")

    apply = sub.add_parser("apply", help="preview or execute a JSON mutation plan")
    apply.add_argument("file", type=Path)
    apply.add_argument("--yes", action="store_true", help="execute writes; omitted means preview only")
    return parser


def main(argv: list[str] | None = None) -> int:
    load_env(ROOT / ".env")
    args = build_parser().parse_args(argv)
    if args.command == "doctor":
        user = current_user()
        print_json({key: user.get(key) for key in ("email", "name", "scheduling_url", "slug", "timezone", "uri")})
    elif args.command == "links":
        links()
    elif args.command == "get":
        print_json(request("GET", args.path, query=parse_query(args.query)))
    elif args.command == "apply":
        apply_plan(args.file, args.yes)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (CliError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1)
